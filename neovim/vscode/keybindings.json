// VS Code keybindings for the vscode-neovim extension.
//
// Merge this array into VS Code's user `keybindings.json`
// (Command Palette: "Preferences: Open Keyboard Shortcuts (JSON)").
//
// These bindings cover the shortcuts that must be executed by VS Code itself
// (LSP, diagnostics, search, formatting, terminal, git gutter). Everything else
// in `neovim/keybindings.md` keeps working through Neovim, because
// vscode-neovim runs a real Nvim with this repository's `init.lua`.
//
// `neovim.mode` is provided by the extension; `editorTextFocus` keeps the
// bindings scoped to editor buffers.
[
  // ---------------------------------------------------------------- LSP ---
  {
    "key": "g d",
    "command": "editor.action.revealDefinition",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g D",
    "command": "editor.action.revealDeclaration",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g y",
    "command": "editor.action.goToTypeDefinition",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g I",
    "command": "editor.action.goToImplementation",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g A",
    "command": "editor.action.goToReferences",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g s",
    "command": "workbench.action.gotoSymbol",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g S",
    "command": "workbench.action.showAllSymbols",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g h",
    "command": "editor.action.showHover",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g .",
    "command": "editor.action.quickFix",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "c d",
    "command": "editor.action.rename",
    "when": "editorTextFocus && neovim.mode == normal"
  },

  // -------------------------------------------------------- diagnostics ---
  {
    "key": "] d",
    "command": "editor.action.marker.nextInFiles",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "[ d",
    "command": "editor.action.marker.prevInFiles",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g ]",
    "command": "editor.action.marker.nextInFiles",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "g [",
    "command": "editor.action.marker.prevInFiles",
    "when": "editorTextFocus && neovim.mode == normal"
  },

  // ------------------------------------------------------------- search ---
  {
    "key": "g /",
    "command": "workbench.action.findInFiles",
    "when": "editorTextFocus && neovim.mode == normal"
  },

  // ---------------------------------------------- format / wrap / term ---
  {
    "key": "space f",
    "command": "editor.action.formatDocument",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "space w",
    "command": "editor.action.toggleWordWrap",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "ctrl+\\",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "editorTextFocus && neovim.mode != insert"
  },

  // ------------------------------------------------- git gutter navigation ---
  {
    "key": "] c",
    "command": "editor.action.dirtydiff.next",
    "when": "editorTextFocus && neovim.mode == normal"
  },
  {
    "key": "[ c",
    "command": "editor.action.dirtydiff.previous",
    "when": "editorTextFocus && neovim.mode == normal"
  }
]
